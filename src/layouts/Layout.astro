<meta name="generator" content={Astro.generator} />
<meta name="description" content={Astro.frontmatter?.description ?? "Cheesecake Corp — our group website."} />
<title>{Astro.frontmatter?.title ?? "Cheesecake Corp"}</title>
</head>
<body>
<header>
<a href="/" class="logo">
<span class="logo-icon">&#x1F9C0;</span>
<span class="logo-text">Cheesecake Corp</span>
</a>
<nav>
<a href="/">Home</a>
<a href="/docs">Docs</a>
<a href="/game">Game</a>
<a href="/minecraft">Minecraft</a>
<a href="/mail">Mail</a>
</nav>
</header>
<main>
<slot />
</main>
<footer>
