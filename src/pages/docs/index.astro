---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Docs - Cheesecake Corp" description="School notes and shared resources.">
  <section class="page-hero" style="--accent: #4a90d9; --bg: #e8f0fa;">
    <span class="icon">&#x1F4DD;</span>
    <h1>Docs</h1>
    <p>Our shared knowledge base &mdash; school notes, references, and everything in between.</p>
  </section>

  <div class="content-card">
    <h2>&#x2197; Access Docs</h2>
    <a href="https://docs.cheesecakecorp.org" target="_blank" rel="noopener noreferrer" class="external-link">
      docs.cheesecakecorp.org
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>

  <div class="content-card">
    <h2>&#x1F4CB; What to Expect</h2>
    <ul>
      <li>&#x2713; Lecture notes &amp; summaries</li>
      <li>&#x2713; Study guides for upcoming exams</li>
      <li>&#x2713; Shared resources and references</li>
    </ul>
  </div>

  <a href="/" class="back-link">&copy; Back to home</a>
</Layout>

<style>
  .page-hero {
    text-align: center;
    padding: 3rem 1rem 2rem;
    background: var(--bg);
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }
  .page-hero .icon { font-size: 3rem; display: block; margin-bottom: 0.5rem; }
  .page-hero h1 { font-size: 2rem; margin-bottom: 0.5rem; color: var(--accent); }
  .page-hero p { color: #6b6560; font-size: 1.1rem; }

  .content-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #e8e0d4;
    padding: 1.75rem;
    margin-bottom: 1.25rem;
  }
  .content-card h2 { font-size: 1.2rem; margin-bottom: 1rem; color: var(--accent); }
  .content-card ul { list-style: none; padding: 0; }
  .content-card li { padding: 0.5rem 0; border-bottom: 1px solid #f0ebe4; }
  .content-card li:last-child { border-bottom: none; }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg);
    color: var(--accent);
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    transition: background 0.2s, transform 0.2s;
  }
  .external-link:hover { transform: translateY(-2px); text-decoration: none; }

  .back-link {
    display: inline-block;
    margin-top: 1rem;
    color: #6b6560;
    font-size: 0.95rem;
  }
  .back-link:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 640px) {
    .page-hero { padding: 2rem 1rem 1.5rem; border-radius: 14px; }
    .content-card { padding: 1.25rem; }
  }
</style>