---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Minecraft Server - Cheesecake Corp" description="Our hosted Minecraft multiplayer server.">
  <section class="page-hero" style="--accent: #4ad97e; --bg: #e8faee;">
    <span class="icon">&#x1F3AE;</span>
    <h1>Minecraft Server</h1>
    <p>Our multiplayer Minecraft server - connect and survive together.</p>
  </section>

  <div class="content-card">
    <h2>&#x1F4CB; Copy Server Address</h2>
    <button id="copy-host" class="copy-btn" data-url="mc.cheesecakecorp.org" aria-label="Copy server address to clipboard">
      <span class="btn-text">mc.cheesecakecorp.org</span>
      <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
      <span class="copy-feedback" aria-live="polite"></span>
    </button>
  </div>

  <div class="content-card">
    <h2>&#x1F3AE; Server Info</h2>
    <ul>
      <li>&#x2713; Open to all members</li>
      <li>&#x2713; Regular updates and new builds</li>
      <li>&#x2713; Survival mode with community events</li>
    </ul>
  </div>

  <a href="/" class="back-link">&larr; Back to home</a>
</Layout>

<style>
  .page-hero { text-align: center; padding: 3rem 1rem 2rem; background: var(--bg); border-radius: 20px; margin-bottom: 1.5rem; }
  .page-hero .icon { font-size: 3rem; display: block; margin-bottom: 0.5rem; }
  .page-hero h1 { font-size: 2rem; margin-bottom: 0.5rem; color: var(--accent); }
  .page-hero p { color: #6b6560; font-size: 1.1rem; }
  .content-card { background: #fff; border-radius: 16px; border: 1px solid #e8e0d4; padding: 1.75rem; margin-bottom: 1.25rem; }
  .content-card h2 { font-size: 1.2rem; margin-bottom: 1rem; color: var(--accent); }
  .content-card ul { list-style: none; padding: 0; }
  .content-card li { padding: 0.5rem 0; border-bottom: 1px solid #f0ebe4; }
  .content-card li:last-child { border-bottom: none; }
  .copy-btn { display: inline-flex; align-items: center; gap: 0; padding: 0.75rem 1.25rem; background: var(--bg); color: var(--accent); border-radius: 10px; font-weight: 600; font-size: 1rem; transition: all 0.2s ease; cursor: pointer; border: none; width: fit-content; }
  .copy-btn:hover { transform: translateY(-2px); background: #d8f5df; }
  .copy-btn:active { transform: translateY(0); }
  .copy-btn.copied { background: #b6eac7; border-color: #4ad97e; }
  .copy-btn.copied .btn-text { color: #1a5c32 !important; }
  .copy-feedback { font-size: 0.8rem; margin-left: 0; opacity: 0; transition: opacity 0.3s; white-space: nowrap; }
  .copy-btn.copied .copy-feedback { opacity: 1; }
  .btn-text { margin-right: 8px; }
  .icon-copy { flex-shrink: 0; stroke: currentColor; }
  .back-link { display: inline-block; margin-top: 1rem; color: #6b6560; font-size: 0.95rem; }
  .back-link:hover { color: var(--accent); text-decoration: none; }
  @media (max-width: 640px) { .page-hero { padding: 2rem 1rem 1.5rem; border-radius: 14px; } .content-card { padding: 1.25rem; } }
</style>

<script>
  document.getElementById("copy-host").addEventListener("click", async () => {
    const btn = document.getElementById("copy-host");
    const url = btn.dataset.url;
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add("copied");
      btn.querySelector(".btn-text").textContent = "Copied!";
      setTimeout(() => {
        btn.classList.remove("copied");
        btn.querySelector(".btn-text").textContent = url;
      }, 2000);
    } catch (err) {
      console.error("Copy failed:", err);
    }
  });
</script>
